+        CAPABILITY_REGISTRY_SUPPLIER = event.create(capabilityEntries, (registry) -> {
+            if (registry instanceof ForgeRegistry<CapabilityEntry> fr) {
+                CAPABILITY_REGISTRY = fr;
+            }
+        });
     }
 
 }
