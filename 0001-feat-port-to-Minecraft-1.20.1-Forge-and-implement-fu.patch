+        // Check for targets in front
+        AABB hitBox = new AABB(forwardPos.x - 2.0, forwardPos.y - 1.5, forwardPos.z - 2.0,
+                forwardPos.x + 2.0, forwardPos.y + 1.5, forwardPos.z + 2.0);
