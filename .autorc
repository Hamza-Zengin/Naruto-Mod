{
  "baseBranch": "master",
  "plugins": [
    [
      "gradle",
      {
        "gradleCommand": "./gradlew",
        "gradleOptions": [""]
      }
    ],
    ["conventional-commits"],
    [
      "omit-commits",
      {
        "subject": ["chore(", "docs:", "ci("]
      }
    ],
    "released",
    ["upload-assets", ["./build/libs/*.jar"]]
  ],
  "owner": "Hamza-Zengin",
  "repo": "Naruto-Mod",
  "name": "Hamza Zengin",
  "onlyPublishWithReleaseLabel": true,
  "shipit": {
    "onlyGraduateWithReleaseLabel": true
  }
}
